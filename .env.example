# Copy this to .env.local for local dev, or set these in Vercel's
# Project Settings -> Environment Variables for production.

# The live backend URL (deployed on FastAPI Cloud):
VITE_API_BASE_URL=https://grid-senseai-backend.fastapicloud.dev

# Set to "false" to use the live backend above. Anything other than the
# literal string "false" keeps mock/demo mode on (useful for offline dev).
VITE_USE_MOCK_DATA=false
