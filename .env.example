# Copy this to .env.local for local dev, or set these in Vercel's
# Project Settings -> Environment Variables for production.

# Your Render backend URL, once deployed (e.g. https://gridsense-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000

# Set to "false" once your Render backend has real trained models loaded.
# Anything other than the literal string "false" keeps mock/demo mode on.
VITE_USE_MOCK_DATA=true
